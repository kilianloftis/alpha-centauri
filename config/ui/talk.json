      "0": "player.title_leader", "1": "player.name_leader",
      "2": "rival.title_leader", "3": "rival.name_leader", "4": "rival.noun_faction",
      "6": "rival.phrase.intent", "8": "rival.adj_name_faction", "9": "player.adj_leader"
