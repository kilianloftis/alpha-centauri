    "then": "diplomacy"
  },
  "scenes": {
    "diplomacy": {
      "prompt": { "text": "DIPLO", "args": "menu" },
      "choices": [
        { "label": { "text": "DIPLOMENU", "item": 2, "args": "menu" }, "then": "proposal" },
        {
          "label": { "text": "DIPLOMENU", "item": 7, "args": "menu" },
          "when": "MayRenouncePact",
          "then": "confirm_renounce"
        },
        { "label": { "text": "DIPLOMENU", "item": 0, "args": "menu" }, "then": "end" }
      ]
    },
    "confirm_renounce": {
      "prompt": { "text": "REALLYBROKE", "args": "menu" },
      "choices": [
        {
          "label": { "text": "REALLYBROKE", "item": 0, "args": "menu" },
          "say": { "text": "DROIDS", "args": "droids" },
          "then": "diplomacy"
        },
        {
          "label": { "text": "REALLYBROKE", "item": 1, "args": "menu" },
          "do": "RenouncePact",
          "say": { "text": "BROKEPACT", "args": "broke_pact" },
          "then": "diplomacy"
        }
      ]
    },
    "proposal": {
      "prompt": { "text": "PROPOSAL", "args": "proposal" },
      "choices": [
        {
          "label": { "text": "PROPOSALMENU", "item": 2, "args": "proposal" },
          "do": "ProposePact",
          "on": {
            "Accepted": { "say": { "text": "MAKEPACT", "args": "pact" }, "then": "diplomacy" },
            "Rejected": { "say": { "text": "REJPACT", "args": "refuse_pact" }, "then": "diplomacy" },
            "Invalid": { "say": { "text": "TALKINVALID", "args": "talk" }, "then": "proposal" }
          }
        },
        {
          "label": { "text": "PROPOSALMENU", "item": 3, "args": "proposal" },
          "do": "ProposeTreaty",
          "on": {
            "Accepted": {
              "say": [
                { "text": "MAKETREATY0", "args": "treaty" },
                { "text": "MAKETREATY1", "args": "treaty" }
