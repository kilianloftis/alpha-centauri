              "then": "diplomacy"
            },
            "Rejected": {
              "say": { "text": "REJTREATY", "args": "refuse_treaty" },
              "then": "diplomacy"
            },
            "Invalid": { "say": { "text": "TALKINVALID", "args": "talk" }, "then": "proposal" }
          }
        },
        {
          "label": { "text": "PROPOSALMENU", "item": 3, "args": "proposal" },
          "do": "ProposeTruce",
          "on": {
            "Accepted": { "say": { "text": "MAKETRUCE", "args": "truce" }, "then": "diplomacy" },
            "Rejected": {
              "say": { "text": "REJTREATY", "args": "refuse_treaty" },
              "then": "diplomacy"
            },
            "Invalid": { "say": { "text": "TALKINVALID", "args": "talk" }, "then": "proposal" }
          }
        },
        { "label": { "text": "TALKTRADE", "args": "talk" }, "when": "MayTrade", "then": "trade" },
        { "label": { "text": "PROPOSALMENU", "item": 0, "args": "proposal" }, "then": "diplomacy" }
      ]
    },
    "trade": {
      "prompt": { "text": "TALKTRADEPROMPT", "args": "talk" },
      "draft": { "offer": { "text": "TALKOFFERING" }, "ask": { "text": "TALKASKING" } },
      "choices": [
        {
          "from": "trade_kinds",
          "side": "Offer",
          "labels": {
            "Credits": { "text": "TALKOFFERCREDITS" },
            "Technology": { "text": "TALKOFFERTECH" },
            "Base": { "text": "TALKOFFERBASE" },
            "CommFrequency": { "text": "TALKOFFERCOMMLINK" },
            "WorldMap": { "text": "TALKOFFERMAPS" },
            "DeclareVendetta": { "text": "TALKOFFERVENDETTA" }
          },
          "then": "pick"
        },
        {
          "from": "trade_kinds",
          "side": "Ask",
          "labels": {
            "Credits": { "text": "PROPOSALMENU", "item": 7, "args": "proposal" },
            "Technology": { "text": "PROPOSALMENU", "item": 4, "args": "proposal" },
            "Base": { "text": "PROPOSALMENU", "item": 11, "args": "proposal" },
            "CommFrequency": { "text": "PROPOSALMENU", "item": 6, "args": "proposal" },
            "WorldMap": { "text": "PROPOSALMENU", "item": 9, "args": "proposal" },
            "DeclareVendetta": { "text": "PROPOSALMENU", "item": 10, "args": "proposal" }
          },
          "then": "pick"
        },
        {
          "label": { "text": "TALKPROPOSETRADE" },
          "do": "ProposeTrade",
          "on": {
            "Accepted": { "say": { "text": "TALKACCEPTTRADE", "args": "talk" }, "then": "diplomacy" },
            "Rejected": { "say": { "text": "TALKREFUSETRADE", "args": "talk" }, "then": "diplomacy" },
            "Invalid": { "say": { "text": "TALKINVALID", "args": "talk" }, "then": "trade" }
          }
        },
        { "label": { "text": "TALKCLEARTRADE" }, "do": "ClearTrade", "then": "trade" },
        { "label": { "text": "PROPOSALMENU", "item": 0, "args": "proposal" }, "then": "proposal" }
      ]
    },
    "pick": {
      "prompt": { "text": "TALKPICKPROMPT" },
      "draft": { "offer": { "text": "TALKOFFERING" }, "ask": { "text": "TALKASKING" } },
      "choices": [
        {
          "from": "trade_candidates",
          "labels": {
            "Credits": { "text": "TALKCREDITS", "args": "credits" },
            "Technology": { "text": "TALKTECH", "args": "candidate" },
            "Base": { "text": "TALKBASE", "args": "candidate" },
            "CommFrequency": { "text": "TALKCOMMLINK", "args": "candidate" },
            "WorldMap": { "text": "TALKMAPS" },
            "DeclareVendetta": { "text": "TALKVENDETTA", "args": "candidate" }
          },
          "then": "trade"
        },
        { "label": { "text": "PROPOSALMENU", "item": 0, "args": "proposal" }, "then": "trade" }
      ]
    }
  }
}
