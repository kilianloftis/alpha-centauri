    },
    "treaty": {
      "0": "player.title_leader", "1": "player.name_leader", "2": "player.noun_faction",
      "3": "rival.title_leader", "4": "rival.name_leader", "5": "rival.noun_faction",
      "6": "player.noun_phrase.projects", "7": "rival.noun_phrase.projects"
    },
    "truce": {
      "0": "player.title_leader", "1": "player.name_leader", "2": "player.noun_faction",
      "3": "rival.title_leader", "4": "rival.name_leader", "5": "rival.noun_faction"
    },
    "refuse_pact": {
      "0": "player.pact_brother", "1": "player.title_leader", "2": "player.name_leader",
      "3": "rival.noun_phrase.projects"
    },
    "refuse_treaty": {
      "0": "player.name_leader", "1": "player.title_leader", "2": "player.noun_faction",
      "3": "player.adj_name_faction"
    },
    "talk": { "0": "rival.title_leader", "1": "rival.name_leader" },
    "candidate": { "0": "candidate.name" },
    "credits": { "#0": "candidate.amount" }
  },
  "start": {
    "say": [
      { "text": "INTRONEW0", "args": "introduce" },
      { "text": "INTRONEW1", "args": "introduce" },
      { "text": "INTRONEW2", "args": "introduce", "extra": { "5": "player.noun_faction" } },
      { "text": "INTRONEW4", "args": "introduce" },
      { "text": "INTRONEW5", "args": "introduce" }
