#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
DEFAULT_BUILD_DIR="${ROOT_DIR}/build"
DEFAULT_CONFIG="Debug"

# Low-memory / WSL hosts OOM under heavy C++ parallelism; stronger machines can take 16.
# Override with -j / --jobs, or BD_JOBS in the environment.
function default_parallel_jobs() {
  if [[ -n "${BD_JOBS:-}" ]]; then
    echo "$BD_JOBS"
    return
  fi

  local mem_kb=0
  if [[ -r /proc/meminfo ]]; then
    mem_kb=$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo)
  fi
  local mem_gb=$((mem_kb / 1024 / 1024))

  if (( mem_gb < 16 )); then
    echo 4
  else
    echo 16
  fi
}

function usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  configure [build-dir] [--no-sfml] [--sfml-dir <dir>] [-- <cmake-args>...]
      Create or update the CMake build tree.
      Pass cmake args after --, e.g. -- -DCMAKE_BUILD_TYPE=Release

  build [build-dir] [--config <Debug|Release>] [-j N|--jobs N]
      Build the configured project.

  all [build-dir] [--config <Debug|Release>] [-j N|--jobs N] [--no-sfml] [--sfml-dir <dir>] [-- <cmake-args>...]
      Configure and build in one step.

  test [build-dir] [--config <Debug|Release>] [-j N|--jobs N]
      Build the test suite and run it via ctest.

  clean [build-dir]
      Remove the build directory.

  help
      Show this help message.

Parallelism:
  Default job count is chosen from MemTotal (<16 GiB → 2, else → 16) so constrained
  WSL hosts stay safe while larger machines use more cores. Override with -j / --jobs,
  or set BD_JOBS. Forms: -j2, -j 2, --jobs 2.
EOF
}

# Consumes -jN / -j N / --jobs N from "$@"; sets JOBS (default via default_parallel_jobs).
# Remaining args are left in ARGS.
function parse_common_build_opts() {
  JOBS="$(default_parallel_jobs)"
  ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -j)
        JOBS="$2"
        shift 2
        ;;
      -j*)
        JOBS="${1#-j}"
        shift
        ;;
      --jobs)
        JOBS="$2"
        shift 2
        ;;
      *)
        ARGS+=("$1")
        shift
        ;;
    esac
  done
}

function configure() {
  local build_dir="$DEFAULT_BUILD_DIR"
  local cmake_args=("-DUSE_SFML=ON")

  if [[ $# -gt 0 && "$1" != --* ]]; then
    build_dir="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-sfml)
        cmake_args+=("-DUSE_SFML=OFF")
        shift
        ;;
      --sfml-dir)
        cmake_args+=("-DUSE_SFML=ON" "-DSFML_DIR=$2")
        shift 2
        ;;
      --)
        shift
        cmake_args+=("$@")
        break
        ;;
      *)
        cmake_args+=("$1")
        shift
        ;;
    esac
  done

  mkdir -p "$build_dir"
  cmake -S "$ROOT_DIR" -B "$build_dir" "${cmake_args[@]}"
}

function build() {
  parse_common_build_opts "$@"
  set -- "${ARGS[@]+"${ARGS[@]}"}"

  local build_dir="$DEFAULT_BUILD_DIR"
  local config="$DEFAULT_CONFIG"

  if [[ $# -gt 0 && "$1" != --* ]]; then
    build_dir="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        config="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        if [[ "$build_dir" == "$DEFAULT_BUILD_DIR" ]]; then
          build_dir="$1"
        fi
        shift
        ;;
    esac
  done

  echo "Building with -j${JOBS}"
  cmake --build "$build_dir" --config "$config" -j"$JOBS"
}

function run_tests() {
  parse_common_build_opts "$@"
  set -- "${ARGS[@]+"${ARGS[@]}"}"

  local build_dir="$DEFAULT_BUILD_DIR"
  local config="$DEFAULT_CONFIG"

  if [[ $# -gt 0 && "$1" != --* ]]; then
    build_dir="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        config="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  echo "Building tests with -j${JOBS}"
  cmake --build "$build_dir" --config "$config" --target effects-tests -j"$JOBS"
  ctest --test-dir "$build_dir" --output-on-failure
}

function clean() {
  local build_dir="${1:-$DEFAULT_BUILD_DIR}"
  rm -rf "$build_dir"
  echo "Removed build directory: $build_dir"
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

command="$1"
shift

case "$command" in
  configure)
    configure "$@"
    ;;
  build)
    build "$@"
    ;;
  all)
    parse_common_build_opts "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"

    if [[ $# -gt 0 && "$1" != --* ]]; then
      build_dir="$1"
      shift
    else
      build_dir="$DEFAULT_BUILD_DIR"
    fi
    config="$DEFAULT_CONFIG"
    cmake_args=("-DUSE_SFML=ON")

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --config)
          config="$2"
          shift 2
          ;;
        --no-sfml)
          cmake_args+=("-DUSE_SFML=OFF")
          shift
          ;;
        --sfml-dir)
          cmake_args+=("-DUSE_SFML=ON" "-DSFML_DIR=$2")
          shift 2
          ;;
        --)
          shift
          cmake_args+=("$@")
          break
          ;;
        *)
          cmake_args+=("$1")
          shift
          ;;
      esac
    done

    mkdir -p "$build_dir"
    cmake -S "$ROOT_DIR" -B "$build_dir" -DCMAKE_BUILD_TYPE="$config" "${cmake_args[@]}"
    echo "Building with -j${JOBS}"
    cmake --build "$build_dir" --config "$config" -j"$JOBS"
    ;;
  test)
    run_tests "$@"
    ;;
  clean)
    clean "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command"
    usage
    exit 1
    ;;
esac
