#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
DEFAULT_BUILD_DIR="${ROOT_DIR}/build"
DEFAULT_CONFIG="Debug"

# Heavy C++ parallelism OOMs low-memory hosts: a single TU in this tree peaks near 1 GiB
# resident, so the cap is a memory budget, not a core count. Derived from whichever of
# MemAvailable / MemTotal is smaller (MemAvailable reflects what a WSL host will really
# hand out) minus a reserve for the linker, which peaks late while compiles are in flight.
# Override with -j / --jobs, or BD_JOBS in the environment.
BD_MIB_PER_JOB="${BD_MIB_PER_JOB:-1024}"
BD_MIB_RESERVE="${BD_MIB_RESERVE:-1024}"

function default_parallel_jobs() {
  if [[ -n "${BD_JOBS:-}" ]]; then
    echo "$BD_JOBS"
    return
  fi

  local total_mib=0 avail_mib=0
  if [[ -r /proc/meminfo ]]; then
    total_mib=$(awk '/^MemTotal:/ { print int($2 / 1024); exit }' /proc/meminfo)
    avail_mib=$(awk '/^MemAvailable:/ { print int($2 / 1024); exit }' /proc/meminfo)
  fi

  # No /proc/meminfo (or an unreadable one): stay conservative rather than guess high.
  if (( total_mib == 0 )); then
    echo 2
    return
  fi

  local budget_mib="$total_mib"
  if (( avail_mib > 0 && avail_mib < budget_mib )); then
    budget_mib="$avail_mib"
  fi
  budget_mib=$((budget_mib - BD_MIB_RESERVE))

  local jobs=$((budget_mib / BD_MIB_PER_JOB))
  local cores
  cores=$(nproc 2>/dev/null || echo 1)
  if (( jobs > cores )); then
    jobs="$cores"
  fi
  if (( jobs < 1 )); then
    jobs=1
  fi
  echo "$jobs"
}

function usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  configure [build-dir] [--no-sfml] [--sfml-dir <dir>] [-- <cmake-args>...]
      Create or update the CMake build tree.
      Pass cmake args after --, e.g. -- -DCMAKE_BUILD_TYPE=Release

  build [build-dir] [--config <Debug|Release>] [-j N|--jobs N]
      Build the configured project.

  all [build-dir] [--config <Debug|Release>] [-j N|--jobs N] [--no-sfml] [--sfml-dir <dir>] [-- <cmake-args>...]
      Configure and build in one step.

  test [build-dir] [--config <Debug|Release>] [-j N|--jobs N]
      Build the test suite and run it via ctest, -j N test processes at a time.
      CTest output is printed only when a test fails.

  clean [build-dir]
      Remove the build directory.

  help
      Show this help message.

Parallelism:
  The default job count is a memory budget, not a core count: a single translation unit
  here peaks near 1 GiB, so jobs = (min(MemAvailable, MemTotal) - 1 GiB reserve) / 1 GiB,
  capped at nproc and floored at 1. The reserve covers the linker, which peaks late while
  compiles are still running. Tune with BD_MIB_PER_JOB / BD_MIB_RESERVE, or force a count
  with -j / --jobs or BD_JOBS. Forms: -j2, -j 2, --jobs 2.
EOF
}

# Consumes -jN / -j N / --jobs N from "$@"; sets JOBS (default via default_parallel_jobs).
# Remaining args are left in ARGS.
function parse_common_build_opts() {
  JOBS="$(default_parallel_jobs)"
  ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -j)
        JOBS="$2"
        shift 2
        ;;
      -j*)
        JOBS="${1#-j}"
        shift
        ;;
      --jobs)
        JOBS="$2"
        shift 2
        ;;
      *)
        ARGS+=("$1")
        shift
        ;;
    esac
  done
}

function configure() {
  local build_dir="$DEFAULT_BUILD_DIR"
  local cmake_args=("-DUSE_SFML=ON")

  if [[ $# -gt 0 && "$1" != --* ]]; then
    build_dir="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-sfml)
        cmake_args+=("-DUSE_SFML=OFF")
        shift
        ;;
      --sfml-dir)
        cmake_args+=("-DUSE_SFML=ON" "-DSFML_DIR=$2")
        shift 2
        ;;
      --)
        shift
        cmake_args+=("$@")
        break
        ;;
      *)
        cmake_args+=("$1")
        shift
        ;;
    esac
  done

  mkdir -p "$build_dir"
  cmake -S "$ROOT_DIR" -B "$build_dir" "${cmake_args[@]}"
}

function build() {
  parse_common_build_opts "$@"
  set -- "${ARGS[@]+"${ARGS[@]}"}"

  local build_dir="$DEFAULT_BUILD_DIR"
  local config="$DEFAULT_CONFIG"

  if [[ $# -gt 0 && "$1" != --* ]]; then
    build_dir="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        config="$2"
        shift 2
        ;;
      --)
        shift
        break
        ;;
      *)
        if [[ "$build_dir" == "$DEFAULT_BUILD_DIR" ]]; then
          build_dir="$1"
        fi
        shift
        ;;
    esac
  done

  echo "Building with -j${JOBS}"
  cmake --build "$build_dir" --config "$config" -j"$JOBS"
}

function run_tests() {
  parse_common_build_opts "$@"
  set -- "${ARGS[@]+"${ARGS[@]}"}"

  local build_dir="$DEFAULT_BUILD_DIR"
  local config="$DEFAULT_CONFIG"

  if [[ $# -gt 0 && "$1" != --* ]]; then
    build_dir="$1"
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        config="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  echo "Building tests with -j${JOBS}"
  cmake --build "$build_dir" --config "$config" --target effects-tests -j"$JOBS"

  local test_log
  test_log="$(mktemp)"
  local test_status=0
  ctest --test-dir "$build_dir" --output-on-failure -j"$JOBS" >"$test_log" 2>&1 || test_status=$?
  if [[ "$test_status" -ne 0 ]]; then
    cat "$test_log"
  fi
  rm -f "$test_log"
  return "$test_status"
}

function clean() {
  local build_dir="${1:-$DEFAULT_BUILD_DIR}"
  rm -rf "$build_dir"
  echo "Removed build directory: $build_dir"
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

command="$1"
shift

case "$command" in
  configure)
    configure "$@"
    ;;
  build)
    build "$@"
    ;;
  all)
    parse_common_build_opts "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"

    if [[ $# -gt 0 && "$1" != --* ]]; then
      build_dir="$1"
      shift
    else
      build_dir="$DEFAULT_BUILD_DIR"
    fi
    config="$DEFAULT_CONFIG"
    cmake_args=("-DUSE_SFML=ON")

    while [[ $# -gt 0 ]]; do
      case "$1" in
        --config)
          config="$2"
          shift 2
          ;;
        --no-sfml)
          cmake_args+=("-DUSE_SFML=OFF")
          shift
          ;;
        --sfml-dir)
          cmake_args+=("-DUSE_SFML=ON" "-DSFML_DIR=$2")
          shift 2
          ;;
        --)
          shift
          cmake_args+=("$@")
          break
          ;;
        *)
          cmake_args+=("$1")
          shift
          ;;
      esac
    done

    mkdir -p "$build_dir"
    cmake -S "$ROOT_DIR" -B "$build_dir" -DCMAKE_BUILD_TYPE="$config" "${cmake_args[@]}"
    echo "Building with -j${JOBS}"
    cmake --build "$build_dir" --config "$config" -j"$JOBS"
    ;;
  test)
    run_tests "$@"
    ;;
  clean)
    clean "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $command"
    usage
    exit 1
    ;;
esac
